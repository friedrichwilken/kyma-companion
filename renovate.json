{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": [
    "* 0-2 * * 1"
  ],
  "timezone": "Europe/Berlin",
  "keepUpdatedLabel": "renovate-keep-updated",
  "includePaths": [
    "pyproject.toml",
    "doc_indexer/pyproject.toml",
    "tests/blackbox/pyproject.toml",
    "Dockerfile",
    "doc_indexer/Dockerfile",
    ".github/workflows/**",
    ".github/actions/**"
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScopeDisabled",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "4 days",
  "enabledManagers": [
    "poetry",
    "github-actions",
    "dockerfile"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageExtra": "({{{packageFile}}})"
  },
  "packageRules": [
    {
      "matchManagers": [
        "poetry"
      ],
      "matchFileNames": [
        "pyproject.toml"
      ],
      "groupName": "Dependencies in pyproject.toml",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "poetry"
      ],
      "matchFileNames": [
        "doc_indexer/pyproject.toml"
      ],
      "groupName": "Dependencies in doc_indexer/pyproject.toml",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "poetry"
      ],
      "matchFileNames": [
        "tests/blackbox/pyproject.toml"
      ],
      "groupName": "Dependencies in tests/blackbox/pyproject.toml",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "description": "Keep kyma-project actions and reusable workflows on @main instead of pinning them to a digest",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "kyma-project/**"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile",
        "doc_indexer/Dockerfile"
      ],
      "groupName": "Wolfi base image",
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "matchDatasources": [
        "apk"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
